# URL the browser uses to reach the API.
# Local dev: point directly at the BE (e.g. http://localhost:3000).
# Production (Vercel): set to /api/proxy to avoid mixed-content errors when BE is HTTP.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-side BE URL used by the /api/proxy route (only needed in production).
# Not required for local dev (proxy is not used when NEXT_PUBLIC_API_BASE_URL is a full URL).
API_BE_URL=http://localhost:3000
